NODE_ENV=development

# Local development only: bypasses authentication while both HTTP servers are loopback-bound.
# OIDC mode requires all three provider settings below. This project remains loopback-bound in this stage.
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
# A flat array of approved role names in the verified token. Unknown roles grant no permissions.
OIDC_ROLE_CLAIM=roles

# API (host-only local development; API_HOST must remain loopback)
API_HOST=127.0.0.1
API_PORT=3000
# Exact local browser origin permitted by API CORS
CORS_ORIGIN=http://127.0.0.1:5173
FRONTEND_PORT=5173
FRONTEND_HOST=127.0.0.1
# HTTP loopback API base URL consumed by the React panel
VITE_API_BASE_URL=http://127.0.0.1:3000

# PostgreSQL local development credentials only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dividend_control
POSTGRES_USER=dividend_app
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql://dividend_app:local_dev_only_change_me@127.0.0.1:5432/dividend_control
# Dedicated database for real PostgreSQL integration tests; never point this at production.
TEST_DATABASE_URL=postgresql://dividend_app:local_dev_only_change_me@127.0.0.1:5432/dividend_control_test

# LocalStack SQS only. These are dummy AWS SDK credentials, not payment credentials.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_COMMAND_QUEUE_NAME=dividend-commands
SQS_COMMAND_DLQ_NAME=dividend-commands-dlq
SQS_EVENT_QUEUE_NAME=dividend-events
SQS_EVENT_DLQ_NAME=dividend-events-dlq
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=60
MESSAGING_RETRY_BASE_SECONDS=2
MESSAGING_RETRY_MAX_SECONDS=120
MESSAGING_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
WORKERS_ENABLED=false
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=3001

# Current LocalStack distributions may require a developer auth token.
# Leave empty in the example; provide your own token in the local .env if required.
LOCALSTACK_AUTH_TOKEN=
