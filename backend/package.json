{
  "name": "@dividend/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/main.ts",
    "dev:worker": "bun --env-file=../.env --watch src/worker.ts",
    "start": "bun --env-file=../.env src/main.ts",
    "start:prod": "bun dist/main.js",
    "start:worker": "bun --env-file=../.env dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun --env-file=../.env test test/integration",
    "test:concurrency": "bun --env-file=../.env test test/integration/persistence.integration.test.ts",
    "db:migration:create": "bun --env-file=../.env x mikro-orm migration:create",
    "db:migration:up": "bun --env-file=../.env x mikro-orm migration:up",
    "db:migration:down": "bun --env-file=../.env x mikro-orm migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1166.0",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "dotenv": "^17.2.3",
    "jose": "^6.2.17",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15"
  }
}
